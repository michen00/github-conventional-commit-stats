# GitHub API Configuration
# Required: GitHub Personal Access Token (PAT) with 'public_repo' scope
# Get one at: https://github.com/settings/tokens
# 
# For local development: Copy this file to .env and add your token
# For CI/CD: Set GITHUB_TOKEN as a repository secret in GitHub Actions
GITHUB_TOKEN=ghp_your_token_here

# Optional: Override data directory path (default: ./data)
# CCC_DB_PATH=./data

# Optional: Set logging level (default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR
# CCC_LOG_LEVEL=INFO
